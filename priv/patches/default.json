      {"path": "/type", "value": "nonprofit", "op": "replace"},
      {"path": "/logo_url", "value": "https://upload.wikimedia.org/wikipedia/commons/1/1b/OCLC_logo.svg", "op": "replace"},
      {"path": "/wikipedia", "value": "https://en.wikipedia.org/wiki/OCLC", "op": "replace"}
