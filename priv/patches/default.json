[
  {
    "when": "new_era_education",
    "patch": [
      {"path": "/type", "value": "company", "op": "replace"}
    ]
  },
  {
    "when": "censipam_sistema_de_protecao_da_amazonia",
    "patch": [
      {"path": "/type", "value": "government", "op": "replace"}
    ]
  },
  {
    "when": "kojja_secondary_school",
    "patch": [
      {"path": "/type", "value": "education", "op": "replace"}
    ]
  },
  {
    "when": "danubius_ri",
    "patch": [
      {"path": "/type", "value": "facility", "op": "replace"}
    ]
  },
  {
    "when": "membership_solutions",
    "patch": [
      {"path": "/base_domain", "value": "ukmsl.com", "op": "replace"},
